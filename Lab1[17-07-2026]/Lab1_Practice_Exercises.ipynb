    "# TODO: B10 solution
# Assuming calculate_bill from B8 is available
def bill_and_collect_cash(cart, menu, cash_paid, is_parcel=False):
    try:
        # Check for invalid items first
        for item in cart:
            if item not in menu:
                raise KeyError(f"'{item}' is not on the menu.")

        bill = calculate_bill(cart, menu, is_parcel)
        total = bill['total']
        print(f"Bill total: Rs. {total:.2f}")

        if cash_paid < total:
            raise ValueError("Insufficient cash paid.")

        change = cash_paid - total
        print(f"Cash paid: Rs. {cash_paid:.2f}, Change due: Rs. {change:.2f}")

    except KeyError as e:
        print(f"Error: {e}")
    except ValueError as e:
        print(f"Error: {e}")

# Test cases
menu = {
    "Samosa": 15.0, "Vada": 12.0, "Tea": 10.0, "Cold Coffee": 30.0,
    "Dosa": 40.0, "Idli": 20.0
}

print("--- Test Case 1: Valid Order ---")
bill_and_collect_cash(["Samosa", "Tea"], menu, 50)

print("\n--- Test Case 2: Invalid Item ---")
bill_and_collect_cash(["Samosa", "Pizza"], menu, 100)

print("\n--- Test Case 3: Insufficient Cash ---")
bill_and_collect_cash(["Dosa", "Vada"], menu, 50)\n"
