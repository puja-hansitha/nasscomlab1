    "# TODO: Stretch challenge solution
import os

# Setup from the problem description
menu = {
    "Samosa": {"price": 15.0, "category": "Snacks"},
    "Vada": {"price": 12.0, "category": "Snacks"},
    "Tea": {"price": 10.0, "category": "Beverages"},
    "Cold Coffee": {"price": 30.0, "category": "Beverages"},
    "Dosa": {"price": 40.0, "category": "Meals"},
    "Idli": {"price": 20.0, "category": "Meals"}
}

orders = [
    {"customer": "Ravi",   "cart": ["Samosa", "Tea"],       "tier": "regular", "hour": 13, "is_parcel": False, "cash_paid": 30},
    {"customer": "Ananya", "cart": ["Dosa", "Cold Coffee"], "tier": "gold",    "hour": 12, "is_parcel": True,  "cash_paid": 100},
    {"customer": "Kiran",  "cart": ["Vada", "Idli"],        "tier": "silver",  "hour": 14, "is_parcel": False, "cash_paid": 45},
    {"customer": "Meena",  "cart": ["Pizza"],               "tier": "regular", "hour": 13, "is_parcel": False, "cash_paid": 100},
    {"customer": "Arjun",  "cart": ["Dosa", "Dosa", "Tea"], "tier": "gold",    "hour": 12, "is_parcel": False, "cash_paid": 95},
    {"customer": "Divya",  "cart": ["Tea"],                 "tier": "regular", "hour": 15, "is_parcel": False, "cash_paid": 5},
]

# --- Main Logic ---

# Clean up old log files
if os.path.exists("rush_hour_log.txt"): os.remove("rush_hour_log.txt")
if os.path.exists("failed_transactions.txt"): os.remove("failed_transactions.txt")

# State tracking for summary
total_revenue = 0
revenue_by_category = {"Snacks": 0, "Beverages": 0, "Meals": 0}
item_sales = {}
failed_orders = {}

def process_order(order, menu):
    global total_revenue
    try:
        # --- Bill Calculation ---
        subtotal = 0
        for item in order["cart"]:
            if item not in menu:
                raise KeyError(f"Item '{item}' not on menu")
            subtotal += menu[item]["price"]

        # 1. Peak-hour surcharge
        surcharge = subtotal * 0.08 if order["hour"] in [12, 13] else 0
        subtotal_with_surcharge = subtotal + surcharge

        # 2. Competing discounts
        membership_discount_rates = {"regular": 0, "silver": 0.05, "gold": 0.12}
        membership_discount = subtotal_with_surcharge * membership_discount_rates[order["tier"]]
        
        loyalty_discount = 0
        if subtotal_with_surcharge > 200: loyalty_discount = subtotal_with_surcharge * 0.10
        elif subtotal_with_surcharge > 100: loyalty_discount = subtotal_with_surcharge * 0.05
        
        final_discount = max(membership_discount, loyalty_discount)

        # 3. GST and Packing Charge
        gst = (subtotal_with_surcharge - final_discount) * 0.05
        packing_charge = 5 if order["is_parcel"] else 0
        total = subtotal_with_surcharge - final_discount + gst + packing_charge

        # 4. Check for sufficient cash
        if order["cash_paid"] < total:
            raise ValueError(f"Insufficient cash (paid: {order['cash_paid']}, needed: {total:.2f})")

        # --- Success Path ---
        
        # 5. Log successful order
        with open("rush_hour_log.txt", "a") as f:
            f.write(f"{order['customer']}: Rs.{total:.2f}\n")
        
        # 6. Update summary stats
        total_revenue += total
        for item in order["cart"]:
            category = menu[item]["category"]
            revenue_by_category[category] += menu[item]["price"]
            item_sales[item] = item_sales.get(item, 0) + 1

    except (KeyError, ValueError) as e:
        # --- Failure Path ---
        reason = str(e)
        with open("failed_transactions.txt", "a") as f:
            f.write(f"Customer: {order['customer']}, Reason: {reason}\n")
        failed_orders[reason] = failed_orders.get(reason, 0) + 1


# --- Driver Loop ---
for order in orders:
    process_order(order, menu)

# --- Final Summary ---
print("--- End-of-Rush Summary ---")
print(f"Total Revenue: Rs.{total_revenue:.2f}")

print("\nRevenue by Category:")
for category, amount in revenue_by_category.items():
    print(f"- {category}: Rs.{amount:.2f}")

best_selling_item = max(item_sales, key=item_sales.get)
print(f"\nBest-Selling Item: {best_selling_item} (sold {item_sales[best_selling_item]} times)")

print(f"\nFailed Orders: {sum(failed_orders.values())}")
for reason, count in failed_orders.items():
    print(f"- {reason}: {count} order(s)")\n",
    "\n",
    "\n"
   ]
