    "# TODO: Part C solution
import os

# (Copied from B8)
def calculate_bill(cart, menu, is_parcel=False, gst_rate=0.05):
    subtotal = sum(menu[item] for item in cart)
    discount = 0
    if subtotal > 200:
        discount = subtotal * 0.10
    elif subtotal > 100:
        discount = subtotal * 0.05
    gst = (subtotal - discount) * gst_rate
    packing_charge = 5 if is_parcel else 0
    total = subtotal - discount + gst + packing_charge
    return {"total": total}

# (Copied from B9)
def save_receipt(customer_name, bill):
    with open("my_canteen_sales_log.txt", "a") as f:
        f.write(f"{customer_name}: Rs.{bill['total']:.2f}\n")

def process_customer_order(customer_name, cart, menu, cash_paid, is_parcel=False):
    print(f"--- Processing order for {customer_name} ---")
    try:
        for item in cart:
            if item not in menu:
                raise KeyError(f"'{item}' is not on the menu.")
        
        bill = calculate_bill(cart, menu, is_parcel)
        total = bill['total']
        print(f"Bill total: Rs. {total:.2f}")

        if cash_paid < total:
            raise ValueError("Insufficient cash paid.")
        
        save_receipt(customer_name, bill)
        print("Order successful. Receipt saved.")

    except (KeyError, ValueError) as e:
        print(f"Order failed: {e}")
    print("")

# 1. Define menu
menu = {
    "Samosa": 15.0, "Vada": 12.0, "Tea": 10.0, "Cold Coffee": 30.0,
    "Dosa": 40.0, "Idli": 20.0, "Thali": 150.0
}

# Clean up previous log if it exists
if os.path.exists("my_canteen_sales_log.txt"):
    os.remove("my_canteen_sales_log.txt")

# 6. Bill 3 different customers
customers = [
    {"name": "Ravi", "cart": ["Samosa", "Tea"], "cash": 50},
    {"name": "Ananya", "cart": ["Dosa", "Cold Coffee", "Pizza"], "cash": 200}, # Invalid item
    {"name": "Kiran", "cart": ["Thali"], "cash": 100}, # Insufficient cash
    {"name": "Meena", "cart": ["Idli", "Vada", "Tea"], "cash": 60}
]

for cust in customers:
    process_customer_order(cust["name"], cust["cart"], menu, cust["cash"])

# Print full day's log
print("\n--- Full Day's Sales Log ---")
with open("my_canteen_sales_log.txt", "r") as f:
    print(f.read())\n",
    "\n",
    "\n"
   ]
