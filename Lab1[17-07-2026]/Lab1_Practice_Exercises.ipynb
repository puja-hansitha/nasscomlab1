    "# TODO: B8 solution
def calculate_bill(cart, menu, is_parcel=False, gst_rate=0.05):
    subtotal = sum(menu[item] for item in cart)

    discount = 0
    if subtotal > 200:
        discount = subtotal * 0.10
    elif subtotal > 100:
        discount = subtotal * 0.05

    gst = (subtotal - discount) * gst_rate
    packing_charge = 5 if is_parcel else 0
    total = subtotal - discount + gst + packing_charge

    return {
        "subtotal": subtotal,
        "discount": discount,
        "gst": gst,
        "packing_charge": packing_charge,
        "total": total
    }

# Test cases
menu = {
    "Samosa": 15.0, "Vada": 12.0, "Tea": 10.0, "Cold Coffee": 30.0,
    "Dosa": 40.0, "Idli": 20.0, "Thali": 150.0
}

cart1 = ["Samosa", "Dosa", "Cold Coffee"]
cart2 = ["Thali", "Thali"]

bill1 = calculate_bill(cart1, menu, is_parcel=True)
bill2 = calculate_bill(cart2, menu)

import json
print("--- Bill 1 ---")
print(json.dumps(bill1, indent=2))
print("\n--- Bill 2 ---")
print(json.dumps(bill2, indent=2))\n"
