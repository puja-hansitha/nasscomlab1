   "source": [
    "# TODO: 5. Sets solution
your_skills = {"Python", "Java", "C++", "Git"}
friend_skills = {"Python", "JavaScript", "HTML", "Git"}

print(f"Skills we both know: {your_skills.intersection(friend_skills)}")
