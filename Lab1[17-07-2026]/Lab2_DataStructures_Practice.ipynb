   "metadata": {},
   "outputs": [],
   "source": [
    "# TODO: 8. Set comprehension solution
# Re-creating data from previous exercises for this cell
gradebook = {
    "OS": {"marks": 85, "credits": 3, "faculty": "Dr. A"},
    "DBMS": {"marks": 92, "credits": 3, "faculty": "Dr. B"},
    "CN": {"marks": 78, "credits": 4, "faculty": "Dr. C"},
    "DAA": {"marks": 88, "credits": 4, "faculty": "Dr. D"},
    "SE": {"marks": 95, "credits": 3, "faculty": "Dr. E"}
}
lab_submissions = ["OS", "DBMS", "CN", "OS", "DAA", "DBMS", "OS", "SE"]
unique_subjects_submitted = set(lab_submissions)

high_scoring_submitted = {
    subject for subject, details in gradebook.items()
    if subject in unique_subjects_submitted and details["marks"] >= 85
}
print(high_scoring_submitted)\n"
   ]
